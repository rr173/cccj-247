#!/usr/bin/env python3
"""Thin entry point so the CLI runs under ``python3 -I`` from anywhere.

The ledger package lives in this repository's root, which isolated mode does
not put on ``sys.path`` automatically.  Inserting it here keeps the rest of the
process isolated (no PYTHONPATH, no user site-packages).
"""

from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from migration_ledger.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
